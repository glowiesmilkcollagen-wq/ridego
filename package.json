{
  "name": "ridego",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "^1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "build:preview": "npx eas-cli@latest build -p android --profile preview",
    "start:rider": "APP_VARIANT=rider expo start",
    "build:rider:android": "npx eas-cli@latest build -p android --profile rider-preview",
    "build:rider:ios": "npx eas-cli@latest build -p ios --profile rider-production",
    "start:admin": "APP_VARIANT=admin expo start --web",
    "build:admin": "APP_VARIANT=admin expo export --platform web --output-dir dist-admin",
    "deploy:admin": "npm run build:admin && npx eas-cli@latest deploy --export-dir dist-admin",
    "test:db": "supabase/tests/run.sh"
  },
  "private": true
}
