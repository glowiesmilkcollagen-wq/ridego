{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "rider-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "rider"
      }
    },
    "rider-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "rider"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
