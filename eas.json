{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "rider-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "rider"
      },
      "channel": "rider-preview"
    },
    "rider-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "rider"
      },
      "channel": "rider-production"
    }
  },
  "submit": {
    "production": {},
    "rider-production": {}
  }
}
